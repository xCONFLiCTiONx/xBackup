<Window x:Class="xBackup.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xBackup"
        Title="xBackup — Point-in-Time Restore Manager" Height="680" Width="880"
        MinWidth="720" MinHeight="540"
        Icon="icon.ico"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource AppText}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Border x:Name="Bd" Grid.Column="1" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="true">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="ExpandPath" Data="M2,2 L2,10 L6,6 Z" Fill="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandPath" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="45"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{StaticResource AppText}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ExpandPath" Property="Fill" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type local:RestoreNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2">
                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Name}" Foreground="{Binding ForegroundBrush}" VerticalAlignment="Center" FontSize="12.5" FontFamily="Segoe UI"/>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="POINT-IN-TIME RESTORE MANAGER" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Select a snapshot to reconstruct files from your ReFS backup container. The tree below represents the complete filesystem state at that point in time." FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Configuration -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="RESTORE POINT (SNAPSHOT)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CboSnapshots" DisplayMemberPath="SnapshotDate" SelectedValuePath="Id" SelectionChanged="CboSnapshots_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton x:Name="RbFullRestore" Content="Full Restore (Original)" IsChecked="True" Foreground="{StaticResource AppText}" Margin="0,0,18,0" Checked="RbRestoreMode_Changed"/>
                        <RadioButton x:Name="RbSelectiveRestore" Content="Selective Folder" Foreground="{StaticResource AppText}" Checked="RbRestoreMode_Changed"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="TxtDestLabel" Text="RESTORE DESTINATION FOLDER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <Grid x:Name="GridDestPicker" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDestPath"/>
                        <Button x:Name="BtnBrowseDest" Grid.Column="1" Content="..." Width="36" Margin="6,0,0,0" Click="BtnBrowseDest_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtFullRestoreInfo" Text="Files will be restored to their original locations (e.g. C:\, D:\)." Foreground="{StaticResource Success}" FontSize="11.5" Margin="0,4,0,0" Visibility="Visible"/>

                    <CheckBox x:Name="ChkOverwrite" Content="Overwrite existing files" Foreground="{StaticResource AppText}" Margin="0,12,0,0" IsChecked="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TreeView -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="12" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10" Margin="0,0,0,14">
            <Grid>
                <TreeView x:Name="RestoreTreeView" Background="#121214" BorderThickness="0" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                </TreeView>
                <ProgressBar x:Name="PrgLoading" IsIndeterminate="True" Height="4" VerticalAlignment="Top" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtNoData" Text="Select a restore point to load files..." Foreground="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnSelectAll" Content="Select All" Width="100" Margin="0,0,10,0" Click="BtnSelectAll_Click"/>
                <Button x:Name="BtnClearAll" Content="Clear All" Width="100" Click="BtnClearAll_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnRestore" Content="Start Restore" Width="140" Style="{StaticResource SolidAccentButtonStyle}" Click="BtnRestore_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
