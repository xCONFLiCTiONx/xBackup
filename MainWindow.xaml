<Window x:Class="xBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="Smart Personal Backup Engine" Height="620" Width="880"
        Background="#1E1E1E">

    <Window.Resources>
        <tb:TaskbarIcon x:Key="NotifyIcon"
                        IconSource="pack://application:,,,/xBackup;component/icon.ico"
                        ToolTipText="Personal Backup Engine Active"
                        DoubleClickCommand="{Binding ShowWindowCommand}"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#252526" Foreground="#D4D4D4" BorderBrush="#3E3E42" BorderThickness="1">
                    <ContextMenu.Resources>
                        <!-- Fully dark theme out the MenuItem layout styles including the icon margin column grid gutter -->
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="#252526"/>
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="Show Backup Monitor" Click="MenuShow_Click" />
                    <MenuItem Header="Exit Application" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Global dark styles for UI elements to prevent standard Windows styles bleed-through -->
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252526"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D4D4D4"/>

        <!-- Custom Dark ScrollBar Theme Styles -->
        <Style TargetType="{x:Type RepeatButton}" x:Key="ScrollBarLineButton">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="{x:Type Thumb}" x:Key="ScrollBarPageThumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#4E4E4E" CornerRadius="3" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#6E6E6E"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#9E9E9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="#1E1E1E" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBarLineButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBarLineButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarPageThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ControlTemplate to force the popup menu list container background completely dark -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Grid.ColumnSpan="2" Placement="Bottom" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                                <Border x:Name="DropDownBorder" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=MainGrid}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="True">
                                        <Grid x:Name="Grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="Canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="OpaqueRect" Fill="#1E1E1E" Height="{Binding ActualHeight, ElementName=DropDownBorder}" Width="{Binding ActualWidth, ElementName=DropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Grid.ColumnSpan="2" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto" MinWidth="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" Data="M0,0 L4,4 L8,0 Z" Fill="#858585" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2D2D30"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#D4D4D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header & App Title -->
            <RowDefinition Height="Auto"/>   <!-- Configuration Section -->
            <RowDefinition Height="Auto"/>   <!-- Control Actions Panel -->
            <RowDefinition Height="Auto"/>   <!-- Progress and Metrics Dashboard -->
            <RowDefinition Height="*"/>      <!-- Real-time Activity Log -->
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#3E3E42" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PERSONAL BACKUP ENGINE" FontSize="20" FontWeight="Bold" Foreground="#007ACC"/>
                        <TextBlock Text="Secure, Incremental, Compressed backups for personal user space" FontSize="12" Foreground="#858585" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#3E3E42" CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="TxtStatus" Text="Engine Status: Ready" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#4EC9B0"/>
                    </Border>
                </Grid>
                <ProgressBar x:Name="PrgWaiting" IsIndeterminate="True" Height="4" Margin="0,10,0,-5" Background="#1E1E1E" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Configuration Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Sources Panel -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,10,0" BorderBrush="#3E3E42" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Backup Scopes (System Drives)" FontSize="14" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="ItemsScopes" MaxHeight="86">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="10,8" Margin="0,0,0,6" BorderBrush="#3E3E42" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Sleek Hardware Drive Bay Icon -->
                                        <Grid x:Name="DriveIcon" Grid.Column="0" Width="20" Height="13" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Border BorderBrush="#007ACC" BorderThickness="1.5" CornerRadius="2" Background="#2D2D30">
                                                <Grid>
                                                    <Rectangle Width="5" Height="1.2" Fill="#858585" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    <Ellipse Width="2.5" Height="2.5" Fill="#4EC9B0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="13" Foreground="#D4D4D4" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDrive}" Value="False">
                                        <Setter TargetName="DriveIcon" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="BtnConfigureExclusions" Content="Configure Custom Exclusions..." Height="34" Margin="0,12,0,0" Background="#3E3E42" Foreground="#D4D4D4" Click="BtnConfigureExclusions_Click"/>
                </StackPanel>
            </Border>

            <!-- Destination Configuration Panel -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="6" Padding="15" BorderBrush="#3E3E42" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Storage Container Target &amp; Allocation" FontSize="14" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,0,0,10"/>

                    <TextBlock Text="Backup Destination Folder Root Path:" FontSize="11" Foreground="#858585" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDestRoot" Text="F:\Backup\Home-PC" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#3E3E42" Padding="5" VerticalAlignment="Center"/>
                        <Button x:Name="BtnBrowseDest" Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0" Background="#3E3E42" Click="BtnBrowseDest_Click"/>
                    </Grid>

                    <TextBlock Text="Mount Target Drive Letter Allocation:" FontSize="11" Foreground="#858585" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CboDriveLetter" HorizontalAlignment="Left" Width="80">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#D4D4D4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#007ACC"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Z" IsSelected="True" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="Y" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="X" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="W" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="V" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="U" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="T" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="S" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="R" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="Q" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="P" Background="#1E1E1E" Foreground="#D4D4D4"/>
                        <ComboBoxItem Content="O" Background="#1E1E1E" Foreground="#D4D4D4"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions Panel -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnScheduleTask" Content="Register Midnight Wake Task" Width="230" Background="#3E3E42" Click="BtnScheduleTask_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ChkOverwrite" Content="Overwrite Existing Files" Foreground="#D4D4D4" VerticalAlignment="Center" Margin="0,0,15,0" IsChecked="False"/>
                <Button x:Name="BtnRestore" Content="Restore Files..." Width="150" Margin="0,0,10,0" Background="#3E3E42" Click="BtnRestore_Click"/>
                <Button x:Name="BtnToggleMount" Content="Mount Backup Drive" Width="180" Margin="0,0,10,0" Background="#3E3E42" Click="BtnToggleMount_Click"/>
                <Button x:Name="BtnStop" Content="Stop" Width="80" Margin="0,0,10,0" Background="#B43232" Click="BtnStop_Click" IsEnabled="False"/>
                <Button x:Name="BtnBackup" Content="Execute Incremental Backup" Width="220" Background="#007ACC" Click="BtnBackup_Click"/>
            </StackPanel>
        </Grid>

        <!-- Metrics Dashboard -->
        <Border Grid.Row="3" Background="#252526" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#3E3E42" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Scanned Files" FontSize="11" Foreground="#858585"/>
                        <TextBlock x:Name="LblScanned" Text="0" FontSize="18" FontWeight="Bold" Foreground="#D4D4D4" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Backed Up" FontSize="11" Foreground="#858585"/>
                        <TextBlock x:Name="LblBackedUp" Text="0" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Up-To-Date" FontSize="11" Foreground="#858585"/>
                        <TextBlock x:Name="LblUpToDate" Text="0" FontSize="18" FontWeight="Bold" Foreground="#858585" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Locked / Skipped" FontSize="11" Foreground="#858585"/>
                        <TextBlock x:Name="LblLocked" Text="0" FontSize="18" FontWeight="Bold" Foreground="#DCDCAA" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Total Bytes Mirrored" FontSize="11" Foreground="#858585"/>
                        <TextBlock x:Name="LblSavings" Text="0.0 MB" FontSize="14" FontWeight="Bold" Foreground="#9CDCFE" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="TxtProgressDetails" Text="Ready to begin scanning..." FontSize="12" Foreground="#D4D4D4" Margin="0,0,0,6"/>
                <ProgressBar x:Name="PrgBar" Value="0" Maximum="100" Height="8" Background="#1E1E1E"/>
            </StackPanel>
        </Border>

        <!-- Console Log Output -->
        <Border Grid.Row="4" Background="#1E1E1E" CornerRadius="6" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#2D2D2D" Padding="10,6" CornerRadius="5,5,0,0">
                    <TextBlock Text="Live Operations Feed" FontSize="12" FontWeight="SemiBold" Foreground="#858585"/>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" Background="#111111" VerticalScrollBarVisibility="Auto" Padding="10">
                    <RichTextBox x:Name="RtbLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#D4D4D4" FontFamily="Consolas" FontSize="12" Margin="0">
                        <FlowDocument PagePadding="0"/>
                    </RichTextBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
