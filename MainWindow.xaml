<Window x:Class="xBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        Title="xBackup" Width="1040" Height="680"
        MinWidth="880" MinHeight="580"
        Icon="icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource AppText}">

    <Window.Resources>
        <tb:TaskbarIcon x:Key="NotifyIcon"
                        IconSource="pack://application:,,,/xBackup;component/icon.ico"
                        ToolTipText="xBackup — ReFS Backup Engine"
                        DoubleClickCommand="{Binding ShowWindowCommand}"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="#1A1A1E" Foreground="#F4F4F5" BorderBrush="#2C2C33" BorderThickness="1">
                    <ContextMenu.Resources>
                        <Style TargetType="MenuItem">
                            <Setter Property="Background" Value="#1A1A1E"/>
                            <Setter Property="Foreground" Value="#F4F4F5"/>
                            <Setter Property="Padding" Value="12,7"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#2B1B0E"/>
                                                <Setter Property="Foreground" Value="#FAAD3F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="Show xBackup" Click="MenuShow_Click"/>
                    <MenuItem Header="Exit Application" Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Persistent Navigation Drawer (exact match to xPrivacyGuard) -->
        <Border Grid.Column="0" Background="{StaticResource DrawerBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Padding="16,20">
            <DockPanel LastChildFill="True">
                <!-- Brand Header + Live Status Card -->
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,4,14" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Padding="5" Margin="0,0,12,0">
                            <Image Source="pack://application:,,,/xBackup;component/icon.ico" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="xBackup" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppText}"/>
                            <TextBlock Text="R E F S   B A C K U P" Foreground="{StaticResource Accent}" FontSize="9.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live Engine Status Pill -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="2,0,2,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Ready" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="ReFS" Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{StaticResource PanelBorder}" Margin="2,0,2,14"/>
                </StackPanel>

                <!-- Bottom VHDX Mount Status Card -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="2,14,2,0">
                    <StackPanel>
                        <TextBlock x:Name="DrawerHomeMountText" Text="Home-PC: Unmounted" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="DrawerXServerMountText" Text="xServer: Unmounted" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedText}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Administrator • Verified Dismount" FontSize="9.5" Foreground="{StaticResource Accent}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M3,13 H11 V3 H3 V13 Z M3,21 H11 V15 H3 V21 Z M13,21 H21 V11 H13 V21 Z M13,3 V9 H21 V3 H13 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="15" Height="15" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHomePc" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="HomePc">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20,18 C21.1,18 22,17.1 22,16 V6 C22,4.9 21.1,4 20,4 H4 C2.9,4 2,4.9 2,6 V16 C2,17.1 2.9,18 4,18 H0 V20 H24 V18 H20 Z M4,6 H20 V16 H4 V6 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Home-PC" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavXServer" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="XServer">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M2,4 H22 V10 H2 V4 Z M4,6 V8 H6 V6 H4 Z M2,14 H22 V20 H2 V14 Z M4,16 V18 H6 V16 H4 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="xServer Clone" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavLogs" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Logs">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M4,6 H20 V8 H4 V6 Z M4,11 H20 V13 H4 V11 Z M4,16 H14 V18 H4 V16 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Activity &amp; Logs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked" Tag="Settings">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Schedule &amp; Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="PageTitleText" Text="Dashboard" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="PageSubtitleText" Text="Automated incremental ReFS backups for Home-PC and xServer" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStop" Content="Stop Active Job" Style="{StaticResource DangerButtonStyle}" Click="BtnStop_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRunAll" Content="Run All Backups" Style="{StaticResource SolidAccentButtonStyle}" Click="BtnRunAll_Click"/>
                </StackPanel>
            </Grid>

            <!-- TAB 1: DASHBOARD -->
            <ScrollViewer x:Name="DashboardView" Grid.Row="1" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Dual Target Bento Cards -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Home-PC Card -->
                        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="HOME-PC SNAPSHOT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="Local ReFS Incremental" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="BadgeHomeMount" Grid.Column="1" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtHomeMountBadge" Text="Unmounted" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtDashHomePath" Text="Not configured" FontSize="11.5" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnBackup" Content="Backup Home-PC" Style="{StaticResource AccentButtonStyle}" Click="BtnBackup_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnToggleMount" Content="Mount Drive" Click="BtnToggleMount_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnRestore" Content="Restore..." Click="BtnRestore_Click" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- xServer Clone Card -->
                        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="XSERVER INCREMENTAL CLONE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock x:Name="TxtDashXServerTitle" Text="Not configured" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="BadgeXServerMount" Grid.Column="1" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="999" Padding="10,4" VerticalAlignment="Top">
                                        <TextBlock x:Name="TxtXServerMountBadge" Text="Unmounted" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource MutedText}"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtDashXServerStatus" Text="Last clone: Never run" FontSize="11.5" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button x:Name="BtnDashRunXServer" Content="Clone xServer" Style="{StaticResource AccentButtonStyle}" Click="BtnRunXServer_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnDashMountXServer" Content="Mount Drive" Click="BtnToggleXServerMount_Click" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnDashTestXServer" Content="Test SSH" Click="BtnTestXServer_Click" Margin="0,0,0,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Telemetry Bento Metrics Row -->
                    <UniformGrid Columns="5" Margin="0,0,0,14">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="SCANNED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LblScanned" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="BACKED UP" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LblBackedUp" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Success}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="UP-TO-DATE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LblUpToDate" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="SKIPPED / ERR" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LblLocked" Text="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Warn}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="TRANSFERRED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                                <TextBlock x:Name="LblSavings" Text="0.00 B" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBright}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Daily Schedule Summary Banner -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="DAILY SCHEDULED TASK (12:00 AM)" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="TxtDashScheduleInfo" Text="Checking Windows Task Scheduler..." FontSize="12" Foreground="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open Logs" Click="BtnOpenLogsFolder_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: HOME-PC BACKUP -->
            <ScrollViewer x:Name="HomePcView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Scopes Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Backup Scopes (System Drives)" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Drives included in your Home-PC incremental ReFS snapshots" FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnConfigureExclusions" Grid.Column="1" Content="Configure Scopes &amp; Exclusions" Style="{StaticResource AccentButtonStyle}" Click="BtnConfigureExclusions_Click"/>
                            </Grid>

                            <ItemsControl x:Name="ItemsScopes" MaxHeight="110">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121214" CornerRadius="8" Padding="12,8" Margin="0,0,0,6" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="DriveDot" Grid.Column="0" Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AppText}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="False">
                                                <Setter TargetName="DriveDot" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Storage Container Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ReFS Storage Container (Home-PC)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Destination Folder Root Path" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDestRoot" Text=""/>
                                <Button x:Name="BtnBrowseDest" Grid.Column="1" Content="..." Width="38" Margin="8,0,0,0" Click="BtnBrowseDest_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mount Drive Letter" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboDriveLetter" HorizontalAlignment="Left" Width="80">
                                        <ComboBoxItem Content="Z"/>
                                        <ComboBoxItem Content="Y"/>
                                        <ComboBoxItem Content="X" IsSelected="True"/>
                                        <ComboBoxItem Content="W"/>
                                        <ComboBoxItem Content="V"/>
                                        <ComboBoxItem Content="U"/>
                                        <ComboBoxItem Content="T"/>
                                        <ComboBoxItem Content="S"/>
                                        <ComboBoxItem Content="R"/>
                                        <ComboBoxItem Content="Q"/>
                                        <ComboBoxItem Content="P"/>
                                        <ComboBoxItem Content="O"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dynamic VHDX Capacity (GB)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtContainerSizeGb" Text="200" Width="80" HorizontalContentAlignment="Center" MaxLength="6"/>
                                        <TextBlock Text="GB" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="12"/>
                                        <Button x:Name="BtnResizeVhdx" Content="Grow Container" Click="BtnResizeVhdx_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Maintenance Actions Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Home-PC Operations" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button Content="Execute Incremental Backup" Style="{StaticResource SolidAccentButtonStyle}" Click="BtnBackup_Click" Margin="0,0,10,6"/>
                                <Button x:Name="BtnVerify" Content="Verify Integrity (SHA-256)" Click="BtnVerify_Click" Margin="0,0,10,6"/>
                                <Button Content="Restore Files..." Click="BtnRestore_Click" Margin="0,0,10,6"/>
                                <Button x:Name="BtnHomeMountAlt" Content="Mount / Eject Drive" Click="BtnToggleMount_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: XSERVER INCREMENTAL CLONE -->
            <ScrollViewer x:Name="XServerView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- SSH Target Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="xServer SSH Connection &amp; Clone Policy" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Pulls only new or modified files over SSH into a clean ReFS mirror container." FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button x:Name="BtnTestXServer" Grid.Column="1" Content="Test SSH Connection" Style="{StaticResource AccentButtonStyle}" Click="BtnTestXServer_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="xServer Host / IP" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtXServerHost" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SSH Username" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtXServerUser" Text=""/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Port" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtXServerPort" Text="22" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel>
                                <CheckBox x:Name="ChkXServerEnabled" Content="Include xServer in daily midnight scheduled backup" IsChecked="True" Margin="0,0,22,6"/>
                                <CheckBox x:Name="ChkXServerMirror" Content="Mirror deletions (keep clean exact clone)" IsChecked="True" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ReFS Container Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="xServer ReFS Storage Container" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <TextBlock Text="Destination Folder Root Path (stores xServerBackup.vhdx)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtXServerDestRoot" Text=""/>
                                <Button x:Name="BtnBrowseXServerDest" Grid.Column="1" Content="..." Width="38" Margin="8,0,0,0" Click="BtnBrowseXServerDest_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mount Drive Letter" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CboXServerDriveLetter" HorizontalAlignment="Left" Width="80">
                                        <ComboBoxItem Content="Z"/>
                                        <ComboBoxItem Content="Y" IsSelected="True"/>
                                        <ComboBoxItem Content="X"/>
                                        <ComboBoxItem Content="W"/>
                                        <ComboBoxItem Content="V"/>
                                        <ComboBoxItem Content="U"/>
                                        <ComboBoxItem Content="T"/>
                                        <ComboBoxItem Content="S"/>
                                        <ComboBoxItem Content="R"/>
                                        <ComboBoxItem Content="Q"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Dynamic VHDX Capacity (GB)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TxtXServerContainerSizeGb" Text="100" Width="80" HorizontalContentAlignment="Center" MaxLength="6"/>
                                        <TextBlock Text="GB" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,12,0" FontSize="12"/>
                                        <Button x:Name="BtnResizeXServerVhdx" Content="Grow Container" Click="BtnResizeXServerVhdx_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Remote Paths & Actions Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Included Linux Paths (one per line)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtXServerIncludes" AcceptsReturn="True" Height="82" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,10"/>

                            <TextBlock Text="Excluded Patterns / Paths (one per line)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtXServerExcludes" AcceptsReturn="True" Height="82" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,12"/>

                            <WrapPanel>
                                <Button x:Name="BtnRunXServer" Content="Run xServer Clone Now" Style="{StaticResource SolidAccentButtonStyle}" Click="BtnRunXServer_Click" Margin="0,0,10,6"/>
                                <Button x:Name="BtnToggleXServerMount" Content="Mount xServer Drive" Click="BtnToggleXServerMount_Click" Margin="0,0,10,6"/>
                                <Button x:Name="BtnSaveXServerSettings" Content="Save xServer Settings" Style="{StaticResource AccentButtonStyle}" Click="BtnSaveXServerSettings_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 4: ACTIVITY & LOGS -->
            <Border x:Name="LogsView" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="LIVE OPERATIONS FEED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource MutedText}"/>
                            <TextBlock x:Name="TxtLogFilePath" Text="Persistent disk logging enabled" FontSize="10.5" Foreground="{StaticResource SubtleText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Open Log Folder" Click="BtnOpenLogsFolder_Click" Padding="10,5" FontSize="11.5" Margin="0,0,8,0"/>
                            <Button Content="Clear Feed" Click="BtnClearLog_Click" Padding="10,5" FontSize="11.5"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#121214" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10">
                            <RichTextBox x:Name="RtbLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AppText}" FontFamily="Consolas" FontSize="11.5" Margin="0">
                                <FlowDocument PagePadding="0"/>
                            </RichTextBox>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- TAB 5: SCHEDULE & SETTINGS -->
            <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Scheduled Task Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Daily Midnight Wake Task" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Wakes the PC at 12:00 AM daily, keeps Windows awake for the full Home-PC + xServer run, and verifies all ReFS containers are dismounted before exiting." FontSize="11.5" Foreground="{StaticResource MutedText}" Margin="0,3,0,12" TextWrapping="Wrap"/>

                            <Border Background="#121214" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtSchedulerSummary" Text="Checking task status..." FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource AccentBright}" TextWrapping="Wrap"/>
                            </Border>

                            <WrapPanel>
                                <Button x:Name="BtnScheduleTask" Content="Register Midnight Wake Task" Style="{StaticResource SolidAccentButtonStyle}" Click="BtnScheduleTask_Click" Margin="0,0,10,6"/>
                                <Button Content="Re-register / Update Task (6h Limit)" Style="{StaticResource AccentButtonStyle}" Click="BtnUpdateTask_Click" Margin="0,0,10,6"/>
                                <Button Content="Refresh Status" Click="BtnRefreshTask_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reliability & Integrity Card -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Integrity &amp; Dismount Safety" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                            <TextBlock Text="Automated SHA-256 Integrity Check Cycle (Midnight Silent Task)" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CboIntegrityCycle" HorizontalAlignment="Left" Width="230" Margin="0,0,0,8" SelectionChanged="CboIntegrityCycle_SelectionChanged">
                                <ComboBoxItem Tag="Disabled" Content="Disabled (Manual Only)" IsSelected="True"/>
                                <ComboBoxItem Tag="Daily" Content="Daily"/>
                                <ComboBoxItem Tag="Weekly" Content="Weekly"/>
                                <ComboBoxItem Tag="Monthly" Content="Monthly"/>
                                <ComboBoxItem Tag="Yearly" Content="Yearly"/>
                            </ComboBox>
                            <TextBlock x:Name="TxtIntegrityCycleHint" Text="Disabled: Midnight runs finish in minutes. You can run SHA-256 verification manually anytime from the Home-PC tab." FontSize="11" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button x:Name="BtnVerifyDismountAll" Content="Force Dismount &amp; Verify All VHDX Containers" Style="{StaticResource AccentButtonStyle}" Click="BtnVerifyDismountAll_Click" Margin="0,0,10,6"/>
                                <Button Content="Open Persistent Log Folder" Click="BtnOpenLogsFolder_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Persistent Bottom Progress Strip -->
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtProgressDetails" Grid.Column="0" Text="Ready" FontSize="12" Foreground="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Cursor="Hand" MouseLeftButtonDown="TxtProgressDetails_MouseLeftButtonDown"/>
                        <ProgressBar x:Name="PrgWaiting" Grid.Column="1" IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <ProgressBar x:Name="PrgBar" Value="0" Maximum="100" Height="6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
